# --- LLM provider (OpenAI-compatible) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0

# --- Minecraft bot adapter (typescript side) ---
BOT_API_PORT=8081
BOT_MOCK=0
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=BenchBot
MC_VERSION=1.20.4

# --- Benchmark core (python side) ---
BOT_URL=http://localhost:8081
RESULTS_DIR=results

# --- Pre-run fairness audit (recorded into every run log) ---
# Minecraft version of the server under test (not exposed by the bridge
# protocol, so the default stays "unknown" unless set here).
MINECRAFT_VERSION=1.20.4
# World seed of the Minecraft server under test (int).
# WORLD_SEED=12345

# --- Memory backends ---
# vector (local SQLite baseline)
VECTOR_DB_PATH=results/memory_vector.db
# mem0
MEM0_API_KEY=
MEM0_QDRANT_PATH=results/mem0_qdrant
# letta (self-hosted server via docker-compose.letta.yml)
LETTA_BASE_URL=http://localhost:8283
# Optional bearer token for a SECURE letta server (empty for local dev).
# The letta-client SDK also reads this env var itself when set.
LETTA_API_KEY=
# Embedding model handle + local Ollama model used by the letta server. The
# server defaults (DEFAULT_EMBEDDING_HANDLE) apply these when the adapter
# creates agents, keeping Letta a memory-only backend.
LETTA_EMBEDDING=ollama/nomic-embed-text:latest
LETTA_EMBEDDING_MODEL=nomic-embed-text
# graphiti (temporal knowledge graph on embedded Kuzu)
GRAPHITI_KUZU_PATH=results/graphiti_kuzu
GRAPHITI_EMBEDDER_MODEL=all-MiniLM-L6-v2
LLM_THINKING=disabled
